# PatientTriage.ai Environment Configuration

# Server
PORT=8000
ENVIRONMENT=development
DATABASE_PATH=patient_triage.db

# Optional AI / LLM Explanation Providers
# The system operates 100% deterministically without API keys.
# If provided, Gemini or OpenAI will generate enriched conversational explanations.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend Base API URL (Vite)
VITE_API_URL=http://localhost:8000/api
